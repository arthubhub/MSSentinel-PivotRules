{
  "name": "sentinel-pivot-rules",
  "version": "0.2.0",
  "description": "KQL pivot rules (Statistics, Pivot, Timeline) for Microsoft Sentinel and Defender XDR, compiled from YAML to JSON for the EasyPivot userscript.",
  "scripts": {
    "build": "node scripts/check-schemas.mjs && node scripts/build.mjs",
    "check": "node scripts/check-schemas.mjs && node scripts/build.mjs --check",
    "test": "node scripts/check-schemas.mjs && node scripts/build.mjs --strict && node scripts/test.mjs",
    "update-schemas": "node scripts/update-schemas.mjs",
    "import-schemas": "node scripts/import-schemas.mjs",
    "generate-locations": "node scripts/generate-locations.mjs",
    "generate:win-security": "node scripts/generate-win-security.mjs",
    "assets": "node scripts/readme-assets.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@kusto/language-service-next": "^12.4.1",
    "ajv": "^8.20.0",
    "js-yaml": "^5.4.3"
  },
  "private": true,
  "type": "module"
}
